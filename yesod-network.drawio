        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=none;strokeWidth=2;strokeColor=#475569;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="desk" target="mac">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="notes" value="&lt;b&gt;Traffic crosses the ER7206 under explicit rules&lt;/b&gt;&lt;br&gt;pompom → Yesod: management access • Yesod → NAS: required storage services&lt;br&gt;Return traffic allowed; other cross-VLAN access restricted. Use DNS across VLANs; do not assume .local discovery.&lt;br&gt;&lt;br&gt;&lt;b&gt;*Sefer:&lt;/b&gt; VLAN-aware host bridge / VM NICs; management can remain on the trusted LAN.&lt;br&gt;Desk devices share one VLAN in this design. Separate management or guest VLANs at the desk require a managed desk switch.&lt;br&gt;&lt;br&gt;&lt;b&gt;Tradeoff:&lt;/b&gt; cross-VLAN storage traffic takes the router’s gigabit path. This drawing is a proposal, not deployed configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#64748b;fontSize=16;spacing=10;align=left;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="35" y="820" width="1175" height="230" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
