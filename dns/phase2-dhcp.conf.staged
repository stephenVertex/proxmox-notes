# ============================================================================
# PHASE 2 -- STAGED, NOT ACTIVE. This file is deliberately NOT in
# /etc/dnsmasq.d/ so dnsmasq cannot load it by accident.
#
# Moves VLAN 20 DHCP from the ER7206 to dnsmasq, which is what makes ephemeral
# guests resolvable by name: a DHCP request carries the client's own hostname
# (option 12 / option 81), and dnsmasq answers DNS for that name as soon as it
# issues the lease. No inventory file, no zone edit, no reservation, and no
# Proxmox API call -- the guest is the source of truth for its own name.
#
# ACTIVATION, in this order, in one window (driven by scripts/deploy-lan-dns.sh):
#   0. scripts/deploy-lan-dns.sh --stage-dhcp
#      Copies this file to seykhl:/etc/yesod/dns/ and runs dnsmasq --test only.
#      Still INACTIVE (not in /etc/dnsmasq.d yet); DHCP is not served.
#   1. Build the fresh lease seed from a current router snapshot (preserves IPs):
#      python3 scripts/seed-vlan20-handover.py handover-leases.json \
#              dns/phase2-dhcp.conf.staged > handover.leases
#      Router-off must follow within ~5 min of this snapshot/seed.
#   2. Stephen DISABLES the ER7206's DHCP server for VLAN 20. Two DHCP servers
#      on one L2 segment is worse than none. This must happen FIRST (before activation).
#   3. scripts/deploy-lan-dns.sh --activate-dhcp handover.leases router-off-confirmed
#      seykhl-only: imports the seed to /var/lib/misc/dnsmasq.leases, installs this
#      file as /etc/dnsmasq.d/20-yesod-lan-dhcp.conf, restarts dnsmasq, verifies a
#      UDP/67 listener; auto-removes the config and restarts DNS-only if that fails.
#   4. Verify: a guest renew/ACK yields the same address and its birth name resolves
#      via BOTH resolvers and the controller's service-user path.
# ROLLBACK: scripts/deploy-lan-dns.sh --disable-dhcp
#   Removes /etc/dnsmasq.d/20-yesod-lan-dhcp.conf and restarts dnsmasq DNS-only while
#   PRESERVING /var/lib/misc/dnsmasq.leases; confirms no UDP/67 listener; THEN Stephen
#   re-enables DHCP on the router. If seykhl already ACKed/extended leases, reconcile
#   those allocations into the router's bindings first -- a blind flip-back is not
#   collision-safe. Existing leases keep working throughout.
# ============================================================================

# --- the ephemeral pool, unchanged from the router's policy
dhcp-range=192.168.20.20,192.168.20.119,255.255.255.0,120m  # matches the ER7206's current lease time; do not silently change it at handover

# --- we are the only DHCP server on this segment once the router is off
dhcp-authoritative
dhcp-leasefile=/var/lib/misc/dnsmasq.leases

# --- options handed to every VLAN 20 client
dhcp-option=option:router,192.168.20.1
# DNS: both real resolvers. The router is NOT listed -- it cannot answer
# internal.yesod.work at all, so falling back to it turns a DNS outage into
# a silent "internal names vanished" outage, which is harder to diagnose.
# Updated 2026-09-10 when sefer became the second resolver.
dhcp-option=option:dns-server,192.168.20.202,192.168.20.10
dhcp-option=option:domain-search,internal.yesod.work
# NTP by DHCP -- this is what lets the inventory contract stop hardcoding a
# literal 192.168.20.202 for time (see ys-yes-19c3 / the names-only rule)
# Both time sources, so a seykhl outage does not leave the fleet with none.
dhcp-option=option:ntp-server,192.168.20.202,192.168.20.10

# --- register DHCP names into DNS under our domain
dhcp-fqdn

# ----------------------------------------------------------------------------
# LONG-LIVED HOSTS -- these replace the ER7206's VLAN 20 reservations, in text,
# in a file we can version and edit without a router console. Each one passes
# the test in vlan-cutover.md §18: long-lived AND reached by literal address.
# Addresses are in the reservation half (.120-.254), never the pool.
#
# EPHEMERAL GUESTS ARE DELIBERATELY ABSENT. Gate demons, test databases and
# runners get no entry here and never should -- they are born into the pool and
# name themselves. Adding one is the mistake §18 retracted.
# ----------------------------------------------------------------------------
dhcp-host=BC:24:11:00:88:F5,192.168.20.155,yesod-postgres-server
dhcp-host=BC:24:11:6C:CF:B7,192.168.20.154,seykhl-actions-runner
dhcp-host=BC:24:11:90:A9:CC,192.168.20.138,dertog
dhcp-host=BC:24:11:D0:43:5D,192.168.20.150,doltsvr
dhcp-host=BC:24:11:85:BD:D3,192.168.20.157,litellm-gateway
dhcp-host=BC:24:11:C5:6C:AA,192.168.20.163,obs-vultr
dhcp-host=BC:24:11:B6:A5:A4,192.168.20.167,neo4j
dhcp-host=BC:24:11:B8:5D:94,192.168.20.172,yesod-semantic-graph
# The controller. The one guest that genuinely earns a fixed address.
dhcp-host=BC:24:11:CF:6E:EC,192.168.20.192,yesod-runner-g1-dispatch
# sjbmbp: a laptop on a long router lease (.146, reservation half). Low priority
# per Stephen -- preserved as a one-line known reservation so the handover does
# not change its address; not a fleet member and needs no further investigation.
dhcp-host=00:50:B6:B7:C1:0C,192.168.20.146,sjbmbp

# Braintrust data cleaning v1: durable static guests outside the dynamic pool.
dhcp-host=02:BD:C1:00:07:00,192.168.20.180,dataclean-postgres
dhcp-host=02:BD:C1:00:07:01,192.168.20.181,dataclean-minio
dhcp-host=02:BD:C1:00:07:02,192.168.20.182,dataclean-dagster
dhcp-host=02:BD:C1:00:07:03,192.168.20.183,dataclean-api
