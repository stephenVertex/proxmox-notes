#!/usr/bin/env python3
"""Fixed, read-only inventory command for Dertog's restricted SSH key."""
import concurrent.futures
import datetime
import json
import math
import os
from pathlib import Path
import re
import socket
import subprocess
import time

CPU_WINDOW_SECONDS = 60


def query(node, resource):
    if resource == 'metrics':
        arguments = ['/cluster/metrics/export', '--local-only', '1', '--history', '1',
                     '--start-time', str(int(time.time()) - CPU_WINDOW_SECONDS)]
    else:
        arguments = [f'/nodes/{node}/{resource}']
    result = subprocess.run(
        ['/usr/bin/pvesh', 'get', *arguments, '--output-format', 'json'],
        check=True, capture_output=True, text=True, timeout=15,
    )
    return json.loads(result.stdout)


def cpu_samples(metrics):
    samples = {}
    for metric in metrics.get('data', []):
        if metric.get('metric') != 'cpu_current':
            continue
        timestamp, value = metric.get('timestamp'), metric.get('value')
        if not all(isinstance(v, (int, float)) and not isinstance(v, bool)
                   and math.isfinite(v) for v in (timestamp, value)) or value < 0:
            continue
        # Deduplicate cached generations by their original sample timestamp.
        samples.setdefault(metric['id'], {})[timestamp] = value
    return samples


def cpu_window(samples, kind, row, now):
    if row['status'] != 'running' or row.get('template'):
        return None
    # Do not mix pre-restart samples into a new VM's moving window.
    cutoff = max(now - CPU_WINDOW_SECONDS, now - row.get('uptime', 0))
    recent = sorted((stamp, value) for stamp, value in samples.get(f'{kind}/{row["vmid"]}', {}).items()
                    if cutoff < stamp <= now)
    if not recent:
        return None
    return {'current': recent[-1][1], 'average': sum(v for _, v in recent) / len(recent),
            'sampled_at': recent[-1][0], 'sample_count': len(recent)}


def configured_disks(config, fallback):
    total, found = 0, False
    storage = set()
    for line in config.splitlines():
        if not re.match(r'(?:scsi|sata|virtio|ide|rootfs|mp)\d*:', line):
            continue
        if 'media=cdrom' in line or 'cloudinit' in line:
            continue
        match = re.search(r'(?:,|\s)size=(\d+(?:\.\d+)?)([KMGT]?)', line)
        if match:
            found = True
            total += float(match[1]) * 1024 ** (' KMGT'.index(match[2]) if match[2] else 0)
        volume = re.match(r'\w+:\s*([^:,]+):', line)
        if volume:
            storage.add(volume[1])
    return int(total) if found else fallback, sorted(storage)


def collect(node):
    with concurrent.futures.ThreadPoolExecutor(max_workers=5) as pool:
        futures = {name: pool.submit(query, node, name) for name in ('qemu', 'lxc', 'status', 'storage')}
        metrics = pool.submit(query, node, 'metrics')
        data = {name: future.result() for name, future in futures.items()}
        try:
            samples = cpu_samples(metrics.result())
        except Exception:
            # CPU metrics are optional: keep the inventory available on failure.
            samples = {}
    now = time.time()
    guests = []
    for kind, folder in (('qemu', 'qemu-server'), ('lxc', 'lxc')):
        for row in data[kind]:
            vmid = int(row['vmid'])
            try:
                config = Path(f'/etc/pve/{folder}/{vmid}.conf').read_text().split('\n[')[0]
            except FileNotFoundError:
                config = ''
            disk, storage = configured_disks(config, row.get('maxdisk', 0))
            guests.append({
                'key': f'{node}:{kind}:{vmid}', 'host': node, 'type': kind, 'vmid': vmid,
                'name': row.get('name') or row.get('hostname') or str(vmid),
                'status': 'template' if row.get('template') else row['status'],
                'cpus': row.get('cpus', row.get('maxcpu', 0)),
                'memory_bytes': row.get('maxmem', 0), 'memory_used_bytes': row.get('mem', 0),
                'disk_bytes': disk, 'storage': storage,
                'cpu': cpu_window(samples, kind, row, now),
                'uptime': row.get('uptime', 0), 'lock': row.get('lock'),
                'tags': [tag for tag in row.get('tags', '').split(';') if tag],
            })
    status = data['status']
    return {
        'host': node, 'observed_at': datetime.datetime.now(datetime.timezone.utc).isoformat(),
        'cpu_count': status.get('cpuinfo', {}).get('cpus'),
        'memory': status.get('memory', {}), 'uptime': status.get('uptime'),
        'storage': [{k: row.get(k) for k in ('storage', 'type', 'total', 'used', 'avail', 'active')}
                    for row in data['storage'] if row.get('active')],
        'guests': sorted(guests, key=lambda row: (row['vmid'], row['type'])),
    }


if __name__ == '__main__':
    if os.environ.get('SSH_ORIGINAL_COMMAND', 'inventory') != 'inventory':
        raise SystemExit('Only the inventory command is permitted')
    node = socket.gethostname().split('.')[0]
    if node not in ('sefer', 'seykhl'):
        raise SystemExit('Unexpected Proxmox node')
    print(json.dumps(collect(node), separators=(',', ':')))
